# 이 파일을 .env 로 복사한 뒤 실제 API 키를 입력하세요.
# 키가 없는 프로바이더는 자동으로 비활성화됩니다 (최소 1개 필요).

# (공개 배포용) 앱 접속 비밀번호 — 설정 시 앱 진입에 비밀번호를 요구한다.
# 공개(Anyone with the link)로 열 거면 반드시 설정. 로컬/내부용이면 비워둬도 됨.
APP_PASSWORD=

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI GPT — https://platform.openai.com/
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/
GOOGLE_API_KEY=

# (선택) 모델 오버라이드 — 비워두면 기본값 사용
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-5
# GEMINI_MODEL=gemini-2.5-pro

# (선택) 라이트 모드 경량 모델 오버라이드 — 비워두면 경량 기본값 사용
# ANTHROPIC_LIGHT_MODEL=claude-haiku-4-5-20251001
# OPENAI_LIGHT_MODEL=gpt-5-mini
# GEMINI_LIGHT_MODEL=gemini-3.5-flash

# ─── 조사 이력 아카이브 (선택 — 설정 시 자동 저장·재열람 활성화) ───

# Supabase 프로젝트 URL (예: https://xxxx.supabase.co)
SUPABASE_URL=
# service_role 키 — 서버측 전용 비밀키! 절대 브라우저/저장소에 노출 금지.
# Supabase 대시보드 → Settings → API → service_role. 테이블은
# supabase-ra-runs-setup.sql 을 SQL Editor에서 먼저 실행할 것.
SUPABASE_SERVICE_ROLE_KEY=

# ─── 자동 모니터링 알림 (선택 — 설정한 채널만 활성화됨, 설계서 15) ───
# 테이블은 supabase-ra-watch-setup.sql 을 SQL Editor에서 먼저 실행할 것.
# 정해진 시각의 자동 실행은 GitHub Actions(.github/workflows/watch.yml)가 담당하므로
# 아래 값들은 GitHub → Settings → Secrets and variables → Actions 에도 넣어야 한다.

# 감시 요약에 쓸 프로바이더 고정 (비우면 gemini→openai→anthropic 순으로 자동)
# WATCH_PROVIDER=gemini

# 이메일 알림 (Gmail이면 2단계 인증 후 '앱 비밀번호'를 SMTP_PASSWORD에)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 받는 사람 (비우면 SMTP_USER 로 보냄)
NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM_NAME=리서치 에이전트

# 카카오톡 '나에게 보내기' — developers.kakao.com 앱 등록 후
# 카카오 로그인 + 동의항목 talk_message 활성화 → 리프레시 토큰 발급
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
# KAKAO_CLIENT_SECRET=       # 보안 > Client Secret 을 켰다면 필요

# ─── PPT 디자인 엔진 (선택 — 키를 넣으면 해당 엔진이 활성화됨) ───

# Gamma — https://gamma.app (Pro 이상 플랜에서 Account Settings > API Keys)
GAMMA_API_KEY=

# Canva — https://www.canva.dev/docs/connect/ 앱 등록 후 OAuth 액세스 토큰
CANVA_ACCESS_TOKEN=

# Google Slides — GCP 서비스 계정 JSON 키 파일의 경로 (Slides+Drive API 활성화 필요)
GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SLIDES_SHARE_ROLE=writer   # reader 로 바꾸면 열람 전용 공유
